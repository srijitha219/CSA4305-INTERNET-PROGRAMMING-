<!DOCTYPE html>
<html>
<head>
<title>TechSavvy Electronics</title>
<style>
*{box-sizing:border-box}
body{margin:0;font-family:Arial;background:#f5f5f5}
header{background:#222;color:white;padding:20px;text-align:center}
nav a{color:white;text-decoration:none;margin:15px}
.container{max-width:1100px;margin:30px auto;padding:20px}
.products{display:grid;grid-template-columns:repeat(4,1fr);gap:20px}
.card{background:white;padding:20px;border-radius:10px;box-shadow:0 3px 10px #ccc}
.card img{width:100%;height:150px;object-fit:contain}
button{background:#222;color:white;border:0;padding:12px;width:100%;margin-top:10px;border-radius:5px}
.search{padding:15px;width:100%;border:1px solid #ccc}
footer{background:#222;color:white;text-align:center;padding:20px}
@media(max-width:800px){.products{grid-template-columns:1fr 1fr}}
@media(max-width:500px){.products{grid-template-columns:1fr}}
</style>
</head>

<body>

<header>
<h1>📱 TechSavvy</h1>
<nav>
<a href="#">Home</a>
<a href="#">Products</a>
<a href="#">Categories</a>
<a href="#">Cart</a>
<a href="#">Login</a>
</nav>
</header>

<div class="container">

<input class="search" placeholder="Search products...">

<h2>Popular Products</h2>

<div class="products">

<div class="card">
<h3>Smartphone</h3>
<p>₹25,000</p>
<p>Available</p>
<button onclick="alert('Smartphone added to cart')">Add to Cart</button>
</div>

<div class="card">
<h3>Laptop</h3>
<p>₹65,000</p>
<p>Available</p>
<button onclick="alert('Laptop added to cart')">Add to Cart</button>
</div>

<div class="card">
<h3>Tablet</h3>
<p>₹30,000</p>
<p>Available</p>
<button onclick="alert('Tablet added to cart')">Add to Cart</button>
</div>

<div class="card">
<h3>Headphones</h3>
<p>₹3,000</p>
<p>Available</p>
<button onclick="alert('Headphones added to cart')">Add to Cart</button>
</div>

</div>

<div class="card">
<h2>Checkout</h2>
<input placeholder="Customer Name">
<input placeholder="Address">
<input placeholder="Phone Number">
<button onclick="alert('Order Placed Successfully')">Checkout</button>
</div>

</div>

<footer>© 2026 TechSavvy Electronics</footer>

</body>
</html>
