<!DOCTYPE html>
<html>
<head>
<title>BlossomGifts</title>
<style>
*{box-sizing:border-box}
body{margin:0;font-family:Arial;background:#fff5f7}
header{background:#e83e8c;color:white;padding:20px;text-align:center}
nav a{color:white;text-decoration:none;margin:15px}
.container{max-width:1100px;margin:30px auto;padding:20px}
.products{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}
.card{background:white;padding:20px;border-radius:12px;box-shadow:0 3px 10px #ddd}
.card img{width:100%;height:180px;object-fit:cover;border-radius:8px}
input,select,button{width:100%;padding:12px;margin:7px 0}
button{background:#e83e8c;color:white;border:0;border-radius:5px}
footer{background:#e83e8c;color:white;text-align:center;padding:20px}
@media(max-width:700px){.products{grid-template-columns:1fr}}
</style>
</head>

<body>

<header>
<h1>🌸 BlossomGifts</h1>
<nav>
<a href="#">Home</a>
<a href="#">Flowers</a>
<a href="#">Gifts</a>
<a href="#">My Orders</a>
<a href="#">Login</a>
</nav>
</header>

<div class="container">

<div class="card">
<h2>Search Gifts</h2>
<input placeholder="Search flowers or gifts">
<select>
<option>Select Occasion</option>
<option>Birthday</option>
<option>Wedding</option>
<option>Anniversary</option>
<option>Festival</option>
</select>
<button onclick="alert('Items Found')">Search</button>
</div>

<h2>Popular Gifts</h2>

<div class="products">

<div class="card">
<h3>Rose Bouquet</h3>
<p>₹799</p>
<p>Beautiful red rose bouquet.</p>
<button onclick="alert('Added to Cart')">Add to Cart</button>
</div>

<div class="card">
<h3>Gift Basket</h3>
<p>₹1,299</p>
<p>Premium gift basket.</p>
<button onclick="alert('Added to Cart')">Add to Cart</button>
</div>

<div class="card">
<h3>Birthday Gift</h3>
<p>₹999</p>
<p>Special birthday gift set.</p>
<button onclick="alert('Added to Cart')">Add to Cart</button>
</div>

</div>

<div class="card">
<h2>Delivery Details</h2>
<input placeholder="Customer Name">
<input placeholder="Delivery Address">
<input type="date">
<input type="time">
<select>
<option>Select Payment Method</option>
<option>UPI</option>
<option>Credit Card</option>
<option>Debit Card</option>
</select>
<button onclick="alert('Order Placed Successfully')">Place Order</button>
</div>

</div>

<footer>© 2026 BlossomGifts - Online Flowers & Gifts</footer>

</body>
</html>
