<!DOCTYPE html>
<html>
<head>
<title>InsureEasy</title>
<style>
*{box-sizing:border-box}
body{margin:0;font-family:Arial;background:#eef7ff}
header{background:#0066cc;color:white;padding:20px;text-align:center}
nav a{color:white;text-decoration:none;margin:15px}
.container{max-width:1100px;margin:30px auto;padding:20px}
.policies{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}
.card{background:white;padding:25px;border-radius:10px;box-shadow:0 3px 10px #ccc}
button,input,select{width:100%;padding:12px;margin:7px 0}
button{background:#0066cc;color:white;border:0;border-radius:5px}
footer{background:#0066cc;color:white;text-align:center;padding:20px}
@media(max-width:700px){.policies{grid-template-columns:1fr}}
</style>
</head>

<body>

<header>
<h1>🛡️ InsureEasy</h1>
<nav>
<a href="#">Home</a>
<a href="#">Policies</a>
<a href="#">Compare</a>
<a href="#">My Policy</a>
<a href="#">Login</a>
</nav>
</header>

<div class="container">

<div class="card">
<h2>Compare Insurance Policies</h2>
<select>
<option>Select Insurance Type</option>
<option>Health Insurance</option>
<option>Vehicle Insurance</option>
<option>Home Insurance</option>
</select>
<button onclick="alert('Policies Compared')">Compare Policies</button>
</div>

<h2>Insurance Policies</h2>

<div class="policies">

<div class="card">
<h3>Health Insurance</h3>
<p>Coverage: ₹10 Lakhs</p>
<p>Premium: ₹15,000/year</p>
<button onclick="alert('Policy Selected')">Purchase Policy</button>
</div>

<div class="card">
<h3>Vehicle Insurance</h3>
<p>Coverage: ₹5 Lakhs</p>
<p>Premium: ₹8,000/year</p>
<button onclick="alert('Policy Selected')">Purchase Policy</button>
</div>

<div class="card">
<h3>Home Insurance</h3>
<p>Coverage: ₹25 Lakhs</p>
<p>Premium: ₹12,000/year</p>
<button onclick="alert('Policy Selected')">Purchase Policy</button>
</div>

</div>

<div class="card">
<h2>Premium Payment</h2>
<input placeholder="Policy Number">
<input placeholder="Amount">
<button onclick="alert('Premium Payment Successful')">Pay Premium</button>
</div>

</div>

<footer>© 2026 InsureEasy Insurance Management</footer>

</body>
</html>
